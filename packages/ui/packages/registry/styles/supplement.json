{
  "cn-accordion": "flex flex-col",
  "cn-accordion-content": "overflow-hidden",
  "cn-accordion-trigger": "relative flex-1 items-start border border-transparent disabled:pointer-events-none disabled:opacity-50",
  "cn-alert-description": "[&_a]:underline [&_a]:underline-offset-3 [&_a]:hover:text-foreground",
  "cn-alert-title": "[&_a]:underline [&_a]:underline-offset-3 [&_a]:hover:text-foreground",
  "cn-avatar": "after:absolute after:inset-0 after:border after:border-border after:mix-blend-darken dark:after:mix-blend-lighten",
  "cn-avatar-badge": "bg-blend-color",
  "cn-avatar-image": "object-cover",
  "cn-breadcrumb-list": "wrap-break-word",
  "cn-button": "select-none",
  "cn-card-header": "has-data-[slot=card-description]:grid-rows-[auto_auto]",
  "cn-checkbox": "relative after:absolute after:-inset-x-3 after:-inset-y-2",
  "cn-empty": "w-full",
  "cn-field-description": "group-has-data-horizontal/field:text-balance",
  "cn-field-orientation-horizontal": "*:data-[slot=field-label]:flex-auto has-[>[data-slot=field-content]]:[&>[role=checkbox],[role=radio]]:mt-px",
  "cn-field-orientation-responsive": "*:w-full @md/field-group:*:w-auto @md/field-group:*:data-[slot=field-label]:flex-auto @md/field-group:has-[>[data-slot=field-content]]:[&>[role=checkbox],[role=radio]]:mt-px",
  "cn-field-orientation-vertical": "*:w-full",
  "cn-progress": "relative flex items-center overflow-x-hidden",
  "cn-radio-group": "w-full",
  "cn-radio-group-item": "relative after:absolute after:-inset-x-3 after:-inset-y-2",
  "cn-switch": "after:absolute after:-inset-x-3 after:-inset-y-2 data-disabled:cursor-not-allowed data-disabled:opacity-50",
  "cn-switch-thumb": "pointer-events-none block ring-0 transition-transform"
}
