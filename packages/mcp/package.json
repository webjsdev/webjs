{
  "name": "@webjsdev/mcp",
  "version": "0.1.15",
  "type": "module",
  "description": "The Model Context Protocol server for WebJs, a full-stack JavaScript framework built on web components with server-side rendering and no build step. Gives AI coding agents live app introspection over routes, actions, components, and convention checks, plus a knowledge layer of docs, recipes, and framework source.",
  "bin": {
    "webjs-mcp": "bin/webjs-mcp.js"
  },
  "exports": {
    ".": {
      "default": "./src/mcp.js"
    },
    "./check-report": {
      "default": "./src/check-report.js"
    },
    "./routes-report": {
      "default": "./src/routes-report.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "resources"
  ],
  "dependencies": {
    "@webjsdev/server": "^0.8.0",
    "@webjsdev/ui": "^0.3.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webjsdev/webjs.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/webjsdev/webjs#readme",
  "bugs": "https://github.com/webjsdev/webjs/issues",
  "license": "MIT",
  "keywords": [
    "webjs",
    "mcp",
    "model-context-protocol",
    "ai",
    "agents"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepack": "node scripts/copy-mcp-resources.js",
    "postpack": "node scripts/clean-mcp-resources.js"
  }
}
