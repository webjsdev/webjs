# webjs environment variables
# `webjs create` copied this to .env (gitignored). A fresh clone copies it again:
# cp .env.example .env
#
# Opinionated defaults: set these and the framework auto-configures.

# ── Server ──────────────────────────────────────────────────────────
PORT=8080

# ── Secrets ─────────────────────────────────────────────────────────
# `webjs create` wrote a .env with a fresh random value for each of these.
# Set your own in production. Generate one with:
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# createAuth() signs its session token with AUTH_SECRET.
AUTH_SECRET=
# The session() middleware signs its cookie with SESSION_SECRET.
SESSION_SECRET=

# ── OAuth providers (optional - enable the ones you need) ───────────
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# ── Redis (production scaling) ──────────────────────────────────────
# Set this and cache, sessions, rate limiting, and pub/sub all
# automatically use Redis. Without it, everything uses in-memory
# defaults (great for development).
# REDIS_URL=redis://localhost:6379

# ── Database ────────────────────────────────────────────────────────
# Used by Drizzle. SQLite for dev, PostgreSQL for production (--db postgres).
DATABASE_URL=file:./db/dev.db
