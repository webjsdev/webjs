{
  "name": "@webjsdev/website",
  "version": "0.1.1",
  "type": "module",
  "private": true,
  "imports": {
    "#*": "./*"
  },
  "scripts": {
    "dev": "webjs dev --port ${PORT:-5001}",
    "start": "webjs start",
    "typecheck": "node scripts/copy-registry.mjs && webjs typecheck",
    "pretest": "node scripts/copy-registry.mjs && npm run css:build && npm run css:build:ui && npm run css:build:ui-styles",
    "test": "webjs test",
    "pretest:browser": "node scripts/copy-registry.mjs && npm run css:build && npm run css:build:ui && npm run css:build:ui-styles",
    "test:browser": "webjs test --browser",
    "css:build": "tailwindcss -i ./public/input.css -o ./public/tailwind.css --minify",
    "css:build:ui": "tailwindcss -i ./public/ui-input.css -o ./public/ui.css --minify",
    "css:build:ui-styles": "node scripts/build-ui-styles.mjs",
    "ci": "webjs ci"
  },
  "webjs": {
    "seed": false,
    "redirects": [
      {
        "source": "/why",
        "destination": "/why-webjs",
        "permanent": true
      },
      {
        "source": "/docs/ui",
        "destination": "/ui",
        "permanent": true
      },
      {
        "source": "/ui/docs/components/typography",
        "destination": "/ui/docs/typeset",
        "permanent": true
      }
    ],
    "dev": {
      "before": [
        "node scripts/copy-registry.mjs",
        "npm run css:build",
        "npm run css:build:ui",
        "npm run css:build:ui-styles"
      ],
      "regenerate": [
        {
          "output": "public/tailwind.css",
          "command": "node scripts/copy-registry.mjs && tailwindcss -i ./public/input.css -o ./public/tailwind.css --minify",
          "inputs": [
            "app",
            "components",
            "lib",
            "modules",
            "../packages/ui/packages/registry/components",
            "../packages/ui/packages/registry/lib",
            "public/input.css"
          ]
        },
        {
          "output": "public/ui.css",
          "command": "node scripts/copy-registry.mjs && tailwindcss -i ./public/ui-input.css -o ./public/ui.css --minify",
          "inputs": [
            "app/ui",
            "components",
            "lib/ui",
            "modules/ui",
            "../packages/ui/packages/registry/components",
            "../packages/ui/packages/registry/blocks",
            "../packages/ui/packages/registry/lib",
            "../packages/ui/packages/registry/styles",
            "../packages/ui/packages/registry/themes",
            "scripts/build-ui-themes.mjs",
            "public/ui-input.css",
            "public/ui-theme.css"
          ]
        },
        {
          "output": "public/ui-styles/rhea.css",
          "command": "node scripts/build-ui-styles.mjs",
          "inputs": [
            "../packages/ui/packages/registry/styles",
            "public/ui-theme.css",
            "scripts/build-ui-styles.mjs"
          ]
        }
      ],
      "watch": [
        "../blog"
      ]
    },
    "start": {
      "before": [
        "node scripts/copy-registry.mjs",
        "npm run css:build",
        "npm run css:build:ui",
        "npm run css:build:ui-styles"
      ]
    },
    "doctor": {
      "gate": {
        "UNMARKED_ASSET_LINKS": "error"
      }
    },
    "ci": {
      "steps": [
        {
          "title": "Checks",
          "parallel": 2,
          "steps": [
            { "title": "Conventions", "run": "webjs check" },
            { "title": "Health", "run": "webjs doctor" },
            { "title": "Types", "run": "npm run typecheck" },
            { "title": "Tests: node + browser", "run": "npm test" }
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@webjsdev/cli": "^0.10.0",
    "@webjsdev/core": "^0.7.0",
    "@webjsdev/server": "^0.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@web/test-runner": "^0.20.0",
    "@web/test-runner-playwright": "^0.11.0",
    "playwright": "^1.59.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
