#!/usr/bin/env bash
# Pre-push: run the fast local CI subset before a branch with an open PR is
# pushed (#1593).
#
# CI is local now (scripts/ci.sh; GitHub Actions no longer runs ci.yml on a
# push or a PR), so this hook is what keeps a red head from reaching a PR.
# It runs `scripts/ci.sh --quick` (setup, conventions, the Node suite: a
# couple of minutes, nothing load-sensitive) for each pushed branch that has
# an OPEN pull request, unless the commit already passed the full list. The
# full list, browsers and e2e included, is scripts/ci-merge.sh's job. The single skip is a docs-only change: every file that
# differs from origin/main is Markdown, or under docs/ or blog/.
#
# The commit being pushed must be the one checked out here, since that is the
# tree the run tests. A branch with no PR yet is pushed without a run; the
# PR's next push, and scripts/ci-merge.sh, run it.
#
# Installed by core.hooksPath=.hooks, which `npm install` sets
# (scripts/git-worktree-safe.mjs). Nothing here reads an environment switch:
# a skipped run is visible as a missing `local-ci` status on the PR.
set -uo pipefail

# Git exports these to hooks; tests that build scratch repos must not inherit
# them, or they write into this repository (scripts/ci.sh unsets them too).
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR \
  GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE

REPO="webjsdev/webjs"
zero=0000000000000000000000000000000000000000
fail=0

while read -r local_ref local_sha remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # a branch deletion
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
  branch="${remote_ref#refs/heads/}"
  [ "$branch" = main ] && continue                 # refused elsewhere

  pr="$(timeout 15 gh api "repos/$REPO/pulls?head=webjsdev:$branch&state=open" --jq '.[0].number // empty' 2>/dev/null || true)"
  if [ -z "$pr" ]; then
    echo "pre-push: $branch has no open PR; local CI not run (it runs on the PR's pushes and in scripts/ci-merge.sh)"
    continue
  fi

  git fetch -q origin main 2>/dev/null || true
  changed="$(git diff --name-only "origin/main...$local_sha" 2>/dev/null)"
  if [ -n "$changed" ] && ! printf '%s\n' "$changed" | grep -qvE '(\.md$|^docs/|^blog/)'; then
    echo "pre-push: PR #$pr changes only docs (*.md, docs/, blog/); local CI skipped"
    continue
  fi

  if [ -f "${TMPDIR:-/tmp}/webjs-ci-${local_sha:0:12}/PASS" ]; then
    echo "pre-push: ${local_sha:0:12} already passed local CI; not repeating it"
    continue
  fi

  if [ "$(git rev-parse HEAD)" != "$local_sha" ]; then
    echo "pre-push: PR #$pr: pushing ${local_sha:0:12} but ${PWD} has $(git rev-parse --short=12 HEAD) checked out." >&2
    echo "pre-push: push from the worktree that has the commit checked out, so local CI tests what is pushed." >&2
    fail=1
    continue
  fi

  echo "pre-push: PR #$pr: running the quick local CI subset on ${local_sha:0:12} (scripts/ci.sh --quick; the full list runs in scripts/ci-merge.sh)"
  if ! bash scripts/ci.sh --quick </dev/null; then
    echo "pre-push: local CI failed; the push is refused. Fix it, commit, and push again." >&2
    fail=1
  fi
done

exit "$fail"
